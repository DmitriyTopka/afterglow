# Copy to .env.local and fill in. Never commit real keys.

# mock = canned responses in the Qloo wire format, live = hackathon.api.qloo.com
QLOO_MODE=mock
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# mock = rule-based extractor and templated copy, live = Claude API
LLM_MODE=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Hard ceiling on Claude spend per server instance per UTC day, in USD
LLM_DAILY_USD_CAP=1
